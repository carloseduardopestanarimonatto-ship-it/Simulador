rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Host: dono do site (e-mail confirmado)
    function isHost() {
      return request.auth != null
        && request.auth.token.email == 'rimonattoc@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Editor: aprovado pelo host (documento em /editores)
    function isEditor() {
      return request.auth != null
        && (isHost() || exists(/databases/$(database)/documents/editores/$(request.auth.uid)));
    }
    // Conteúdo público: qualquer visitante lê, só a equipe escreve
    match /noticias/{id} { allow read: if true; allow write: if isEditor(); }
    match /podcasts/{id} { allow read: if true; allow write: if isEditor(); }
    match /mundo/{id}    { allow read: if true; allow write: if isEditor(); }
    // Equipe aprovada: só o host aprova ou remove
    match /editores/{uid} { allow read: if request.auth != null; allow write: if isHost(); }
    // Pedidos de acesso: cada pessoa cria o seu, só o host vê todos e decide
    match /pedidos/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if isHost() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if isHost();
    }
  }
}
